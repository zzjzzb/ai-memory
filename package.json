{
  "name": "dsh-ai-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness Cordis plugin: thin host over the ai-memory Rust + SQLite crate (not a JS memory rewrite)",
  "license": "MIT OR Apache-2.0",
  "author": "Zhou Ben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjzzb/ai-memory.git"
  },
  "homepage": "https://github.com/zzjzzb/ai-memory",
  "bugs": {
    "url": "https://github.com/zzjzzb/ai-memory/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "Cargo.toml",
    "src",
    "integrations/dsh-ai-memory",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "docs/INSTALL_DSH.md",
    "docs/INSTALL_DSH.zh-CN.md"
  ],
  "scripts": {
    "prepare": "node integrations/dsh-ai-memory/scripts/build-native.mjs",
    "build": "node integrations/dsh-ai-memory/scripts/build-native.mjs",
    "test": "node scripts/check-dsh-bundle.mjs && DSH_AI_MEMORY_SKIP_NATIVE=1 npm test --prefix integrations/dsh-ai-memory"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ai-memory",
    "sqlite"
  ]
}
